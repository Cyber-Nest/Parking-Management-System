  "auth_tokens": [{ "key": { "refresh_token": 1 }, "unique": true }, { "key": { "user_id": 1, "user_type": 1, "revoked": 1 } }, { "key": { "expires_at": 1 } }],
  "users": [{ "key": { "username": 1 }, "unique": true }, { "key": { "email": 1 }, "unique": true }, { "key": { "role_id": 1, "is_active": 1 } }],
  "parking_lots": [{ "key": { "lot_name": 1 } }, { "key": { "owner_id": 1 } }],
