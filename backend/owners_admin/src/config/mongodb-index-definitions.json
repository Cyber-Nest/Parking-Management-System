  "parking_plans": [{ "key": { "parking_lot_id": 1, "status": 1 } }, { "key": { "parking_zone_id": 1 } }],
  "parking_sessions": [{ "key": { "license_plate": 1, "status": 1 } }, { "key": { "start_time": -1 } }, { "key": { "parking_lot_id": 1, "status": 1, "start_time": -1 } }],
  "payments": [{ "key": { "session_id": 1, "paid_at": -1 } }, { "key": { "ticket_id": 1, "status": 1 } }],
  "penalty_tickets": [{ "key": { "ticket_number": 1 }, "unique": true }, { "key": { "status": 1, "date_issued": -1 } }, { "key": { "license_plate": 1, "date_issued": -1 } }],
  "ticket_photos": [{ "key": { "ticket_id": 1, "uploaded_at": 1 } }],
  "officer_evidence": [{ "key": { "ticket_id": 1, "created_at": 1 } }],
  "penalty_rules": [{ "key": { "code": 1 }, "unique": true }, { "key": { "status": 1 } }],
  "bookings": [{ "key": { "booking_reference": 1 }, "unique": true }, { "key": { "user_id": 1, "created_at": -1 } }, { "key": { "status": 1, "start_time": 1 } }],
  "transactions": [{ "key": { "transaction_reference": 1 }, "unique": true }, { "key": { "user_email": 1, "initiated_at": -1 } }, { "key": { "status": 1, "initiated_at": -1 } }, { "key": { "stripe_payment_intent_id": 1 } }, { "key": { "transaction_type": 1, "initiated_at": -1 } }],
  "invoices": [{ "key": { "invoice_number": 1 }, "unique": true }, { "key": { "booking_id": 1 } }, { "key": { "transaction_id": 1 } }, { "key": { "customer_email": 1, "invoice_date": -1 } }, { "key": { "status": 1, "invoice_date": -1 } }, { "key": { "payment_status": 1, "invoice_date": -1 } }],
  "taxes": [{ "key": { "parking_lot_id": 1, "is_active": 1 } }, { "key": { "created_at": -1 } }],
  "pricings": [{ "key": { "parking_lot_id": 1, "is_active": 1 } }, { "key": { "tax_id": 1 } }, { "key": { "created_at": -1 } }],
  "system_settings": [{ "key": { "parking_lot_id": 1 }, "unique": true, "partialFilterExpression": { "parking_lot_id": { "$type": "string" } } }],
  "admin_roles_permissions": [{ "key": { "role_id": 1 } }],
  "audit_logs": [{ "key": { "created_at": -1 } }],
  "email_logs": [{ "key": { "recipient_email": 1, "created_at": -1 } }, { "key": { "related_id": 1 } }]
